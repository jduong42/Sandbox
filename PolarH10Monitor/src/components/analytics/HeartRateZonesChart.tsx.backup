import React, { useState } from 'react';
import {
  View,
  Text,
  StyleSheet,
  Dimensions,
  TouchableOpacity,
  Modal,
  ScrollView,
} from 'react-native';
import { theme } from '../../theme';
import { ChartData } from '../../types/training';

const { width: screenWidth } = Dimensions.get('window');
const chartWidth = screenWidth - theme.spacing.xl * 2;

interface HeartRateZonesChartProps {
  data: ChartData;
  style?: any;
}

export const HeartRateZonesChart: React.FC<HeartRateZonesChartProps> = ({
  data,
  style,
}) => {
  const [modalVisible, setModalVisible] = useState(false);
  const [selectedZone, setSelectedZone] = useState<number | null>(null);

  const maxValue = Math.max(...data.data.map(point => point.y));
  const barHeight = 35; // Fixed height for each horizontal bar
  const maxBarWidth = chartWidth - 200; // Increased bar length: 110px labels + 90px for minutes

  const getZoneInfo = (index: number) => {
    const zoneData = [
      {
        name: 'Zone 1',
        range: '50-60%',
        color: '#4CAF50',
        description: 'Very Light',
      },
      {
        name: 'Zone 2',
        range: '60-70%',
        color: '#8BC34A',
        description: 'Light',
      },
      {
        name: 'Zone 3',
        range: '70-80%',
        color: '#FFC107',
        description: 'Moderate',
      },
      {
        name: 'Zone 4',
        range: '80-90%',
        color: '#FF9800',
        description: 'Hard',
      },
      {
        name: 'Zone 5',
        range: '90-100%',
        color: '#F44336',
        description: 'Maximum',
      },
    ];
    return zoneData[index] || zoneData[0];
  };

  const handleZonePress = (zoneIndex: number) => {
    setSelectedZone(zoneIndex);
    setModalVisible(true);
  };

  const getZoneModalContent = (zoneIndex: number) => {
    const zoneContents = [
      {
        title: 'Zone 1 - Active Recovery',
        subtitle: '50-60% of Max Heart Rate',
        description:
          'Very gentle exercise that promotes recovery and blood flow without adding stress.',
        benefits:
          'Enhances recovery, improves circulation, reduces muscle soreness',
        examples: [
          'Easy walking with friends while chatting',
          'Gentle yoga or stretching sessions',
          'Leisurely bike ride around the neighborhood',
          'Easy swimming with relaxed strokes',
          'Light recreational activities',
        ],
        duration: 'Can sustain for hours',
        feeling: 'Very comfortable, barely breathing harder than normal',
        when: 'Recovery days, warm-ups, cool-downs, or when feeling tired',
      },
      {
        title: 'Zone 2 - Aerobic Base',
        subtitle: '60-70% of Max Heart Rate',
        description:
          'The foundation zone that builds aerobic capacity and fat-burning efficiency.',
        benefits:
          'Builds aerobic base, improves fat metabolism, develops capillary density',
        examples: [
          'Easy jogging where you can hold conversation',
          'Comfortable cycling pace on flat terrain',
          'Hiking uphill at steady, comfortable pace',
          'Continuous swimming with easy breathing',
          'Cross-country skiing at conversational pace',
        ],
        duration: '30 minutes to several hours',
        feeling: 'Comfortable effort, can speak in full sentences',
        when: '70-80% of your training should be in this zone',
      },
      {
        title: 'Zone 3 - Aerobic Threshold',
        subtitle: '70-80% of Max Heart Rate',
        description:
          'Moderately hard effort that improves aerobic power and endurance.',
        benefits:
          'Improves aerobic power, lactate processing, race pace endurance',
        examples: [
          'Tempo runs or marathon race pace',
          'Steady cycling up moderate hills',
          'Swimming sets with controlled breathing',
          'Rowing at sustained competitive pace',
          'Uphill skiing requiring steady effort',
        ],
        duration: '20-60 minutes continuously',
        feeling: 'Comfortably hard, can speak short phrases only',
        when: 'Tempo workouts, longer intervals, race simulation',
      },
      {
        title: 'Zone 4 - Lactate Threshold',
        subtitle: '80-90% of Max Heart Rate',
        description:
          'Hard effort at the edge of sustainable intensity. Critical for racing performance.',
        benefits: 'Improves lactate threshold, VO2max, anaerobic power',
        examples: [
          '5K-10K race pace or hard intervals',
          'Time trial effort or hill climbing',
          'Fast swimming with heavy breathing',
          'Racing pace rowing intervals',
          'Sports drills requiring high intensity',
        ],
        duration: '8-40 minutes in intervals',
        feeling: 'Hard effort, can only speak 1-2 words',
        when: 'Quality workouts, race-specific training, intervals',
      },
      {
        title: 'Zone 5 - Neuromuscular Power',
        subtitle: '90-100% of Max Heart Rate',
        description:
          'Maximum effort that develops explosive power and speed. Very demanding on the body.',
        benefits: 'Improves VO2max, anaerobic capacity, neuromuscular power',
        examples: [
          'All-out sprints or 800m race pace',
          'Hill sprints or maximum power efforts',
          'Sprint swimming with maximum effort',
          'High-intensity interval training (HIIT)',
          'Any maximum effort lasting 30s-8min',
        ],
        duration: '30 seconds to 8 minutes (with rest)',
        feeling: 'Very hard to maximal, cannot speak',
        when: 'Speed work, VO2max intervals, race finishing kicks',
      },
    ];
    return zoneContents[zoneIndex];
  };

  const renderZoneModal = () => {
    if (selectedZone === null) return null;

    const content = getZoneModalContent(selectedZone);
    const zoneInfo = getZoneInfo(selectedZone);

    return (
      <Modal
        visible={modalVisible}
        transparent={true}
        animationType="fade"
        onRequestClose={() => setModalVisible(false)}
      >
        <TouchableOpacity
          style={styles.modalOverlay}
          activeOpacity={1}
          onPress={() => setModalVisible(false)}
        >
          <TouchableOpacity
            style={{
              backgroundColor: theme.colors.surface,
              borderRadius: theme.borderRadius.lg,
              padding: theme.spacing.lg,
              width: '90%',
              maxWidth: 400,
              height: '95%', // ALMOST FULL SCREEN - NO SCROLLING NEEDED
            }}
            activeOpacity={1}
            onPress={() => {}} // Prevent modal closing when touching content
          >
            <Text style={[styles.modalTitle, { color: zoneInfo.color }]}>
              {content.title}
            </Text>
            <Text style={styles.modalSubtitle}>{content.subtitle}</Text>

            {/* NO SCROLLVIEW - JUST THE WORKING CONTENT */}
            <View
              style={{
                padding: 16,
                backgroundColor: theme.colors.surface,
                flex: 1,
              }}
            >
              <Text
                style={{
                  fontSize: 16,
                  color: theme.colors.text,
                  marginBottom: 16,
                  lineHeight: 24,
                }}
              >
                {content.description}
              </Text>

              <Text
                style={{
                  fontSize: 16,
                  fontWeight: 'bold',
                  color: theme.colors.text,
                  marginBottom: 8,
                }}
              >
                Benefits:
              </Text>
              <Text
                style={{
                  fontSize: 14,
                  color: theme.colors.textSecondary,
                  marginBottom: 16,
                  lineHeight: 20,
                }}
              >
                {content.benefits}
              </Text>

              <Text
                style={{
                  fontSize: 16,
                  fontWeight: 'bold',
                  color: theme.colors.text,
                  marginBottom: 8,
                }}
              >
                Real Examples:
              </Text>
              {content.examples.map((example, index) => (
                <Text
                  key={index}
                  style={{
                    fontSize: 14,
                    color: theme.colors.text,
                    marginBottom: 6,
                    lineHeight: 20,
                  }}
                >
                  • {example}
                </Text>
              ))}

              <Text
                style={{
                  fontSize: 16,
                  fontWeight: 'bold',
                  color: theme.colors.text,
                  marginBottom: 8,
                  marginTop: 16,
                }}
              >
                Duration:
              </Text>
              <Text
                style={{
                  fontSize: 14,
                  color: theme.colors.textSecondary,
                  marginBottom: 12,
                  lineHeight: 20,
                }}
              >
                {content.duration}
              </Text>

              <Text
                style={{
                  fontSize: 16,
                  fontWeight: 'bold',
                  color: theme.colors.text,
                  marginBottom: 8,
                }}
              >
                How It Feels:
              </Text>
              <Text
                style={{
                  fontSize: 14,
                  color: theme.colors.textSecondary,
                  marginBottom: 12,
                  lineHeight: 20,
                }}
              >
                {content.feeling}
              </Text>

              <Text
                style={{
                  fontSize: 16,
                  fontWeight: 'bold',
                  color: theme.colors.text,
                  marginBottom: 8,
                }}
              >
                When to Use:
              </Text>
              <Text
                style={{
                  fontSize: 14,
                  color: theme.colors.textSecondary,
                  marginBottom: 12,
                  lineHeight: 20,
                }}
              >
                {content.when}
              </Text>
            </View>

            <TouchableOpacity
              style={[styles.closeButton, { backgroundColor: zoneInfo.color }]}
              onPress={() => setModalVisible(false)}
            >
              <Text style={styles.closeButtonText}>Got it!</Text>
            </TouchableOpacity>
          </TouchableOpacity>
        </TouchableOpacity>
      </Modal>
    );
  };

  return (
    <View style={[styles.container, style]}>
      <View style={styles.horizontalChartContainer}>
        {data.data.map((point, index) => {
          const zoneInfo = getZoneInfo(index);
          const barWidth =
            maxValue > 0 ? (point.y / maxValue) * maxBarWidth : 0;

          return (
            <TouchableOpacity
              key={index}
              style={styles.horizontalBarRow}
              onPress={() => handleZonePress(index)}
              activeOpacity={0.7}
            >
              {/* Zone label on the left */}
              <View style={styles.zoneLabel}>
                <Text style={styles.zoneName}>{zoneInfo.name}</Text>
                <Text style={styles.zoneRange}>{zoneInfo.range}</Text>
                <Text style={styles.zoneDescription}>
                  {zoneInfo.description}
                </Text>
              </View>

              {/* Horizontal bar */}
              <View style={styles.barContainer}>
                <View
                  style={[
                    styles.horizontalBar,
                    {
                      width: Math.max(barWidth, point.y > 0 ? 4 : 0),
                      backgroundColor: zoneInfo.color,
                      height: barHeight - 8, // Add some margin
                    },
                  ]}
                />

                {/* Minutes at the end of bar */}
                {point.y > 0 && (
                  <Text
                    style={[
                      styles.minutesAtEnd,
                      { left: Math.max(barWidth + 8, 50) },
                    ]}
                  >
                    {point.y} min
                  </Text>
                )}
              </View>
            </TouchableOpacity>
          );
        })}
      </View>

      {/* Modal */}
      {renderZoneModal()}
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    backgroundColor: theme.colors.surface,
    borderRadius: theme.borderRadius.lg,
    padding: theme.spacing.sm,
    marginVertical: theme.spacing.md,
    shadowColor: '#000',
    shadowOffset: {
      width: 0,
      height: 2,
    },
    shadowOpacity: 0.1,
    shadowRadius: 4,
    elevation: 3,
  },
  horizontalChartContainer: {
    paddingVertical: theme.spacing.xs,
  },
  horizontalBarRow: {
    flexDirection: 'row',
    alignItems: 'center',
    marginVertical: 2,
    minHeight: 45,
  },
  zoneLabel: {
    width: 110,
    paddingRight: theme.spacing.xs,
    paddingLeft: theme.spacing.sm,
  },
  zoneName: {
    fontSize: theme.typography.sizes.sm,
    fontWeight: theme.typography.weights.bold,
    color: theme.colors.text,
  },
  zoneRange: {
    fontSize: theme.typography.sizes.xs,
    color: theme.colors.primary,
    fontWeight: theme.typography.weights.semiBold,
    marginTop: 2,
  },
  zoneDescription: {
    fontSize: theme.typography.sizes.xs,
    color: theme.colors.textSecondary,
    marginTop: 2,
  },
  barContainer: {
    flex: 1,
    flexDirection: 'row',
    alignItems: 'center',
    position: 'relative',
    paddingRight: 50, // Reduced padding for longer bars
  },
  horizontalBar: {
    borderRadius: 6,
    minWidth: 4,
  },
  minutesAtEnd: {
    fontSize: theme.typography.sizes.sm,
    fontWeight: theme.typography.weights.bold,
    color: theme.colors.text,
    position: 'absolute',
    minWidth: 60, // Ensure space for "XXX min"
  },
  modalOverlay: {
    flex: 1,
    backgroundColor: 'rgba(0, 0, 0, 0.7)',
    justifyContent: 'center',
    alignItems: 'center',
    padding: theme.spacing.xl,
  },
  modalContent: {
    backgroundColor: theme.colors.surface,
    borderRadius: theme.borderRadius.lg,
    padding: theme.spacing.lg,
    width: '90%',
    maxWidth: 400,
    maxHeight: '90%', // Much taller modal
    flexDirection: 'column',
  },
  modalScrollView: {
    flex: 1,
    marginVertical: theme.spacing.sm,
  },
  modalScrollContentContainer: {
    paddingBottom: theme.spacing.lg,
  },
  modalContentArea: {
    flex: 1, // Take available space
    paddingVertical: theme.spacing.sm,
    overflow: 'hidden', // Hide overflow instead of scrolling
  },
  modalScrollContent: {
    paddingBottom: theme.spacing.xl,
    minHeight: 500, // Ensure content is tall enough to scroll
  },
  modalFooter: {
    paddingTop: theme.spacing.sm,
    borderTopWidth: 1,
    borderTopColor: theme.colors.backgroundSecondary,
  },
  scrollBottomPadding: {
    height: theme.spacing.lg,
  },
  scrollHint: {
    fontSize: 12,
    color: theme.colors.textSecondary,
    textAlign: 'center',
    fontStyle: 'italic',
    marginVertical: theme.spacing.xs,
  },
  modalTitle: {
    fontSize: 20,
    fontWeight: 'bold',
    marginBottom: theme.spacing.xs,
    textAlign: 'center',
  },
  modalSubtitle: {
    fontSize: 16,
    color: theme.colors.textSecondary,
    fontWeight: '600',
    textAlign: 'center',
    marginBottom: theme.spacing.md,
  },
  modalDescription: {
    fontSize: 16,
    color: theme.colors.text,
    marginBottom: theme.spacing.lg,
    lineHeight: 22,
  },
  modalSectionTitle: {
    fontSize: 16,
    fontWeight: '600',
    color: theme.colors.text,
    marginTop: theme.spacing.md,
    marginBottom: theme.spacing.sm,
  },
  modalText: {
    fontSize: 14,
    color: theme.colors.textSecondary,
    lineHeight: 20,
    marginBottom: theme.spacing.sm,
  },
  exampleText: {
    fontSize: 14,
    color: theme.colors.text,
    lineHeight: 20,
    marginBottom: theme.spacing.xs,
    paddingLeft: theme.spacing.sm,
  },
  closeButton: {
    paddingVertical: theme.spacing.md,
    borderRadius: theme.borderRadius.md,
    alignItems: 'center',
    marginTop: theme.spacing.sm,
  },
  closeButtonText: {
    color: theme.colors.textOnPrimary,
    fontSize: 16,
    fontWeight: '600',
  },
});
